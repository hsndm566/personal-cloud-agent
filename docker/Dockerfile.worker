FROM python:3.13.14-slim

WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY pyproject.toml .
COPY uv.lock .
RUN pip install --no-cache-dir uv==0.12.5
RUN uv sync --frozen --no-install-project --no-dev

COPY src/agents/ ./agents/
COPY src/agent_foundation/ ./agent_foundation/
COPY src/control_plane/ ./control_plane/
COPY src/core/ ./core/
COPY src/memory/ ./memory/
COPY src/model_gateway/ ./model_gateway/
COPY src/schema/ ./schema/
COPY src/worker/ ./worker/
COPY skills/ ./skills/

# Validate the standalone worker import path during image build without requiring real model keys.
RUN python -m compileall -q /app \
    && USE_FAKE_MODEL=true python -c "import worker.main"

CMD ["python", "-m", "worker.main"]
